# Cloudflare Worker secrets/variables to configure in the dashboard or Wrangler.
# Do NOT commit real values.
JWT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=outreach-photos
ALLOWED_ORIGIN=https://YOUR-DOMAIN.example
# DATABASE_URL is not required in production when HYPERDRIVE is configured.
