# Cloudflare Worker secrets/variables to configure in the dashboard or Wrangler.
# Do NOT commit real values.
JWT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=outreach-photos
ALLOWED_ORIGIN=https://YOUR-DOMAIN.example
# LiveKit realtime video credentials. Keep LIVEKIT_API_SECRET server-side only.
LIVEKIT_URL=https://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional HLS output storage for Live -> Watch livestream.
LIVEKIT_HLS_PUBLIC_URL=https://YOUR-HLS-PUBLIC-DOMAIN.example
LIVEKIT_HLS_S3_ACCESS_KEY=
LIVEKIT_HLS_S3_SECRET=
LIVEKIT_HLS_S3_BUCKET=
LIVEKIT_HLS_S3_ENDPOINT=
LIVEKIT_HLS_S3_REGION=auto
# DATABASE_URL is not required in production when HYPERDRIVE is configured.
