{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blw-kenya-zone",
  "main": "worker/secure-entry.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  // Website hosting is deferred until the public site is ready. Uncomment
  // this block (and rebuild client/dist first) to serve the website from
  // this same Worker again — no code changes needed elsewhere.
  // "assets": {
  //   "directory": "./client/dist",
  //   "not_found_handling": "single-page-application"
  // },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d3ea1c0b97c040a89aee64243aa61ba3"
    }
  ],
  "triggers": {
    "crons": ["0 5 * * 6"]
  },
  "vars": {
    "SUPABASE_STORAGE_BUCKET": "outreach-photos",
    "ALLOWED_ORIGIN": ""
  },
  "secrets": {
    "required": ["JWT_SECRET"]
  }
}
