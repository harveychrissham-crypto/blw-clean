# Local Wrangler secrets/variables. Copy to .dev.vars and fill real values.
JWT_SECRET=replace-me
FELLOWSHIP_ADMIN_ACCESS_CODE=replace-me-with-a-strong-leader-code
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=outreach-photos
RESEND_API_KEY=replace-me
EMAIL_FROM=BLW Kenya Zone <notifications@example.org>
# LiveKit realtime video credentials. Keep the API secret server-side only.
LIVEKIT_URL=https://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
# Optional HLS output storage for Live -> Watch livestream.
LIVEKIT_HLS_PUBLIC_URL=https://YOUR-HLS-PUBLIC-DOMAIN.example
LIVEKIT_HLS_S3_ACCESS_KEY=replace-me
LIVEKIT_HLS_S3_SECRET=replace-me
LIVEKIT_HLS_S3_BUCKET=replace-me
LIVEKIT_HLS_S3_ENDPOINT=https://YOUR-S3-ENDPOINT.example
LIVEKIT_HLS_S3_REGION=auto
# For local Wrangler you can use a normal Postgres URL if desired.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
ALLOWED_ORIGIN=http://localhost:5173
