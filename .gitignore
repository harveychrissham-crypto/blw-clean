# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Environment variables / secrets — never commit these
.env
.env.local
.env.*.local
server/.env
client/.env

# Build output
dist/
client/dist/
.vite/

# Logs
npm-debug.log*
*.log

# OS / editor noise
.DS_Store
.vscode/
*.venv/
.venv/

# Capacitor native projects — ios/ and android/ folders themselves ARE
# committed (they're real source-controlled Xcode/Android Studio projects,
# created by `npm run cap:add:ios` / `cap:add:android`), only their build
# artifacts are ignored here.
client/ios/App/Pods/
client/ios/App/build/
client/ios/App/DerivedData/
client/android/.gradle/
client/android/build/
client/android/app/build/
client/android/.idea/
client/android/local.properties

# Android release signing — never commit these
client/android/keystore.properties
client/android/app/release-keystore.jks
client/android/app/*.jks
client/android/app/*.keystore
