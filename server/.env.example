# ── Database ────────────────────────────────────────────────────────────────
# Supabase: Dashboard → Settings → Database → Connection string (URI mode)
# Local Postgres: postgresql://postgres:postgres@localhost:5432/blw
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── Auth ────────────────────────────────────────────────────────────────────
# Use a long random string in production: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# ── CORS ────────────────────────────────────────────────────────────────────
# REQUIRED in production — set to your exact frontend origin, no trailing slash
# e.g. https://blwcampus.org
# In development this defaults to http://localhost:5173 automatically.
ALLOWED_ORIGIN=https://yourdomain.com

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Supabase Storage (for uploaded photos, e.g. outreach story images) ───────
# Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
# Use the "service_role" key here, NOT the "anon" key — keep this secret.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
# The bucket you created in Storage for these uploads.
SUPABASE_STORAGE_BUCKET=outreach-photos

# ── Daily.co (embedded live call on /live) ────────────────────────────────────
# The room URL itself is entered by hand in Leaders Forum → Manage Live Stream
# and stored in the DB, so these two vars aren't required by any code yet.
# Keep them here for when you want the backend to create/manage rooms via the
# Daily REST API instead of leaders pasting a static room URL each time.
# Dashboard → Developers → API keys. Never expose the API key to the frontend.
DAILY_DOMAIN=blwcentraleastafrica.daily.co
DAILY_API_KEY=replace-with-your-daily-api-key
